 MyFonts←∆CreateFonts2 size;MyFonts;s
 'MyFonts'⎕NS''
 MyFonts.standard←(⎕NEW'Font'(('PName' 'Arial')('Size'size)))
 MyFonts.input←(⎕NEW'Font'(('PName' 'Arial')('Size'size)))
 MyFonts.label←(⎕NEW'Font'(('PName' 'Arial')('Size'(size-4))))
 MyFonts.apl←(⎕NEW'Font'(('PName' 'APL385 Unicode')('Size'size)))
