 OnPushButton←{
     (btn n)←⍵
     parms←##.GUI.Dialogs.CreateParmsForShowMsg
     parms.addToCaption←'CVC'
     parms.centerIn←n.∆Form
     msg←⊂'You''ve pressed the "CVC?" button.'
     msg,←⊂'Hover with the mouse over the CVC field'
     msg,←⊂'in order to get further information.'
     _←n.∆globalParms parms ##.GUI.Dialogs.ShowMsg msg
     ⍬
 }
