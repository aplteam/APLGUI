(
 '# Password'
 ''
 '## Overview'
 ''
 'This data type creates a Edit object with FieldTyp=Password. It allows the user to enter a password.'
 ''
 'The result of this data type is a character string.'
 ''
 '## Example'
 ''
 '~~~'
 'DT←#.APLGUI.Enums.InputDataTypes'
 'defMat←⍉⍪''PW'' ''Your password:'' '''' DT.Password 20 1 1'
 '#.APLGUI.Input.Run defMat'
 '~~~'
 ''
 'This results in this GUI:'
 ''
 '![](Images/DataTypes/Password.png)'
)
