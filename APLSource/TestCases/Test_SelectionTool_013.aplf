 r←Test_SelectionTool_013(stopFlag batchFlag);parms;n;v;data;⎕TRAP
⍝ Exercise "SelectionTool. Very long "info"
⍝ "style" defaults to "single" but is ignored when "checkboxes"=1.
 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 parms←#.APLGUI.APLGUI.SelectionTool.CreateParms
 parms.autoPress←0
 parms.timeout←0.1
 parms.addToCaption←'Multiple columns'
 parms.posn←60 70
 parms.info←'This is an extraordinary long info control that even outweighs the matrix displayed below by quite a significant margin, making this visible on cinema screens only'
 parms.checkboxes←1
 (data parms.colTitles)←∆BuildMatrixForListView
 parms.default←10 11 40 50{⍵∊⍺}⍳0⊃⍴data
 n←parms #.APLGUI.APLGUI.SelectionTool.Create data
 ∆Process n.∆Form

 n.∆CloseForm
 r←∆OK
