 r←Test_Notepad_005(stopFlag batchFlag);parms;n;was;⎕TRAP;filename
⍝ Establish (and exercise) the "onFileOpen" callback function in all possible ways.
 r←T._Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

⍝⍝⍝ Preconditions
 filename←''

 #.⎕SHADOW'TEMP'
 #.TEMP←⎕NS''
 #.TEMP.wasCalled←0
 #.TEMP.MyCallback←{
     ⎕THIS.wasCalled←1
     ⍬
 }

 parms←#.APLGUI.APLGUI.Notepad.CreateParmsForFile
 parms.posn←35 25
 parms.hasMenuItem_Open←1
 parms.askForSave←0
 parms.onFileOpen←'#.TEMP.MyCallback'

 n←parms #.APLGUI.APLGUI.Notepad.CreateForEditFile filename
 ∆Process n.∆Form
 ⎕NQ n.menubar.open'Select'
 ⎕NQ n.menubar.quit'Select'
 ∆Process n.∆Form
 →T.GoToTidyUp 1≠#.TEMP.wasCalled

 #.TEMP.wasCalled←0
 parms.onFileOpen←#.TEMP'MyCallback'
 n←parms #.APLGUI.APLGUI.Notepad.CreateForEditFile filename
 ∆Process n.∆Form
 ⎕NQ n.menubar.open'Select'
 ⎕NQ n.menubar.quit'Select'
 ∆Process n.∆Form
 →T.GoToTidyUp 1≠#.TEMP.wasCalled

 was←⎕CS'#.TEMP'
 #.TEMP.wasCalled←0

 parms←#.APLGUI.APLGUI.Notepad.CreateParmsForFile
 parms.posn←35 25
 parms.hasMenuItem_Open←1
 parms.onFileOpen←'MyCallback'

 #.TEMP.n←n←parms #.APLGUI.APLGUI.Notepad.CreateForEditFile filename
 #.APLGUI.TestCases.∆Process n.∆Form
 ⎕NQ n.menubar.open'Select'
 ⎕NQ n.menubar.quit'Select'
 1 #.APLGUI.TestCases.∆Process n.∆Form
 ⎕CS was
 →T.GoToTidyUp 1≠#.TEMP.wasCalled
 r←T._OK

∆TidyUp:
 :Trap 0 ⋄ n.∆CloseForm ⋄ :EndTrap
 :Trap 0 ⋄ #.TEMP.n.∆CloseForm ⋄ :EndTrap
