 r←Test_Input_Callbacks_005(stopFlag batchFlag);n;⎕TRAP;defMat;res;DT;globalParms;parms;txt
⍝ Exercise "Input" with a menubar callback with all three different ways to specify that callback.
 r←T._Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 DT←#.APLGUI.APLGUI.Enums.InputDataTypes
 #.⎕SHADOW'TEMP'
 'TEMP'#.⎕NS''
 #.TEMP.GetMenu←{
     r←''
     r,←⊂'[&Edit] {edit}'
     r,←⊂' Copy input=Ctrl+C : ∆OnMenuInInput {copy}'
     r,←⊂' Paste my data=Ctrl+V : ∆OnMenuInInput {paste}'
     r,←⊂'[Misc] {misc}'
     r,←⊂' Special : ',GetCallbackName,' {special} ; Blablabla'
     r}
 #.TEMP.OnMySpecial←{
     ⎕THIS.flag←1}

 :Section absolutePath
     #.TEMP.⎕FX'r←GetCallbackName' 'r←''#.TEMP.OnMySpecial'''
     #.TEMP.flag←0
     defMat←0 7⍴''
     defMat⍪←'Name' '' 'Johann Wolfgang von Goethe'DT.Character 0 1 1
     globalParms←∆GetGlobalParms
     parms←#.APLGUI.APLGUI.Input.CreateParms
     parms.posn←50 50
     parms.menubar←#.TEMP.GetMenu ⍬
     parms.addToCaption←'No. ',⍕∆GetTestCaseNo
     n←#.APLGUI.APLGUI.Input.Create defMat globalParms parms
     ∆Process n.∆Form
     ⎕NQ n.menubar.special'Select'
     ∆Process n.∆Form
     →T.GoToTidyUp #.TEMP.flag=0
     n.∆CloseForm
 :EndSection

 #.TEMP.GetMenu←{
     r←''
     r,←⊂'[&Edit] {edit}'
     r,←⊂' Copy input=Ctrl+C : ∆OnMenuInInput {copy}'
     r,←⊂' Paste my data=Ctrl+V : ∆OnMenuInInput {paste}'
     r,←⊂'[Misc] {misc}'
     r,←⊂' Special :  ________________________________________ {special} ; Blablabla'
     r}
 ________________________________________←{#.TEMP.flag←1}

 :Section calledFromHere
     #.TEMP.flag←0
     defMat←0 7⍴''
     defMat⍪←'Name' '' 'Johann Wolfgang von Goethe'DT.Character 0 1 1
     globalParms←∆GetGlobalParms
     parms←#.APLGUI.APLGUI.Input.CreateParms
     parms.posn←50 50
     parms.menubar←#.TEMP.GetMenu ⍬
     parms.addToCaption←'No. ',⍕∆GetTestCaseNo
     n←#.APLGUI.APLGUI.Input.Create defMat globalParms parms
     ∆Process n.∆Form
     ⎕NQ n.menubar.special'Select'
     ∆Process n.∆Form
     →T.GoToTidyUp #.TEMP.flag=0
     n.∆CloseForm
 :EndSection


 r←T._OK

∆TidyUp:
 n.∆CloseForm
 ⎕EX' ________________________________________'
