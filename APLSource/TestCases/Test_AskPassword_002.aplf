 r←Test_AskPassword_002(stopFlag batchFlag);myGuiParms;parms;n;⎕TRAP
⍝ Exercise the "AskForPassword" module and perform an input.
 r←T._Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 myGuiParms←#.APLGUI.APLGUI.APLGuiGlobalParms.CreateDefaults
 myGuiParms.regKey←'MyApp\Kai1'
 parms←#.APLGUI.APLGUI.Request.CreateParmsForPassword
 parms.addToCaption←'Password needed'
 parms.validIfEmpty←1

 n←myGuiParms parms #.APLGUI.APLGUI.Request.CreatePasswordRequest 20
 n←#.APLGUI.APLGUI.Request.PolishRequest n
 n.Input ∆KeyPress'12'
 ∆Process n.∆Form
 1 ⎕NQ n.Btn0'Select'
 →T.GoToTidyUp'12'≢n.∆result
 r←T._OK

∆TidyUp:
 :Trap 0 ⋄ n.∆CloseForm ⋄ :EndTrap
