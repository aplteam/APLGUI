 r←Test_Input_DataType_014(stopFlag batchFlag);n;⎕TRAP;defMat;res;DT
⍝ Exercise "Input" with data type "Label".
 r←T._Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 DT←#.APLGUI.APLGUI.Enums.InputDataTypes

 defMat←0 5⍴''
 defMat⍪←'Simpel' 'This is a simple label' ''DT.Label 0
 defMat⍪←'Nested'('This⋄is⋄a⋄nested⋄label')''DT.Label 0

 n←#.APLGUI.APLGUI.Input.Create defMat ⍬ ⍬
 ∆Process n.∆Form

 ⎕NQ n.∆OK'Select'
 ∆Process n.∆Form

 →T.FailsIf~0∊⍴n.∆result

 r←T._OK
