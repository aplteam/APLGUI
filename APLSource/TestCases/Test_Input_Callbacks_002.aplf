 r←Test_Input_Callbacks_002(stopFlag batchFlag);n;⎕TRAP;defMat;res;DT;globalParms;parms
⍝ Exercise "Input" with an "onHelp" callback
 r←T._Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 DT←#.APLGUI.APLGUI.Enums.InputDataTypes

 #.⎕SHADOW'TEMP'
 'TEMP'#.⎕NS''
 #.TEMP.flag←0
 #.TEMP.⎕FX'OnMyHelp n' 'flag←1'

 defMat←0 7⍴''
 defMat⍪←'Text1a' '' 'aa'DT.Character(20 40)1 1
 defMat⍪←'Text2a' '' 'bb'DT.Character 20 1 1
 defMat⍪←'Text3a' '' 'ccc'DT.Character 20 1 1
 defMat⍪←'Text4a' '' 'd'DT.Character 20 1 1
 defMat⍪←'Text5a' '' 'ee'DT.Character 20 1 1
 defMat⍪←'Text6a' '' 'fff'DT.Character 20 1 1

 globalParms←∆GetGlobalParms
 parms←#.APLGUI.APLGUI.Input.CreateParms
 parms.posn←50 50
 parms.addToCaption←'No. ',⍕∆GetTestCaseNo
 parms.helpBtnCaption←'Help me!'
 parms.onHelp←'#.TEMP.OnMyHelp'

 n←#.APLGUI.APLGUI.Input.Create defMat globalParms parms
 0 ∆Process n.∆Form

 1 ⎕NQ n.∆Help'Select'
 →T.GoToTidyUp 1≠#.TEMP.flag

 r←T._OK

∆TidyUp:
 n.∆CloseForm
