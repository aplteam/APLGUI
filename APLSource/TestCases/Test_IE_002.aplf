 r←Test_IE_002(stopFlag batchFlag);⎕TRAP;ref;n;filename;html
⍝ Test IE: view an HTML file with links to sub pages
 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 #.⎕SHADOW'TEMP'
 'TEMP'#.⎕NS''
 ref←∆Create_IEcontainer #.TEMP
 n←#.APLGUI.APLGUI.IE.CreateIE ref
 filename←(#.FilesAndDirs.PWD,'\HTML\A\index.html')
 #.APLGUI.APLGUI.IE.ShowHtmlFile n.IEobject filename
 ⎕DL 0.5
 :Trap 0
     html←#.APLGUI.APLGUI.IE.GetHTML n.IEobject
 :Else
     html←¯1
 :EndTrap
 →FailsIf' '≠1↑0⍴html
 →FailsIf 0∊⍴html
 r←∆OK

∆TidyUp:
 :Trap 0 ⋄ n.∆container.Close ⋄ :EndTrap
 :Trap 0 ⋄ ##.FilesAndDirs.DeleteFile n.∆container.IEobject.∆Filename ⋄ :EndTrap
⍝Done
