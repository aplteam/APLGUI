 r←Test_SelectionTool_003(stopFlag batchFlag);parms;n;v;⎕TRAP
⍝ Exercise "SelectionTool.Create" with "autoPress"
 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 parms←#.APLGUI.APLGUI.SelectionTool.CreateParms
 parms.autoPress←0
 parms.addToCaption←'Test with all sorts of parms set'
 parms.colTitles←⊂'Running numbers'
 parms.default←¯10↑6↑1
 parms.hasVersionField←0
 parms.info←'Does not set "checkbox"'
 parms.posn←60 70
 parms.statusbarMessage←v←'This is an individual statusbar'
 parms.timeout←0.1
 n←parms #.APLGUI.APLGUI.SelectionTool.Create⍕¨1+⍳10
 ∆Process n.∆Form
 →GoToTidyUp(,4)≢#.APLTreeUtils.Where n.List.SelItems
 →GoToTidyUp v≢n.StatusField1.Text
 0.5 ∆Process n.∆Form
 →GoToTidyUp 1≠{6::1 ⋄ 0⊣⍵.Interval}n.Timer
 →GoToTidyUp 4≠#.APLTreeUtils.Where n.List.SelItems
 2 ⎕NQ n.Btn_00'Select'
 ⎕DL 0.5
 →GoToTidyUp n.∆buttons[0]≢n.∆buttonPressed
 →GoToTidyUp n.∆result≢parms.default
 r←∆OK

∆TidyUp:
 n.∆CloseForm
