 r←Test_Menubar_005(stopFlag batchFlag);parms;n;TheForm;⎕TRAP
⍝ Exercise the "Create" method with an invalid definition (invalid names)
 r←T._Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 parms←#.APLGUI.APLGUI.Menubar.CreateParms
 'TheForm'⎕WC'Form'('Coord' 'Pixel')('Posn'(35 45))('Size'(300 400))

 :Trap 0
     n←#.APLGUI.APLGUI.Menubar.Create TheForm MenuDefInvalidName parms(⎕NEW #.APLGUI.APLGUI.KeyCodes)
     →T.FailsIf 1
 :Else
     →T.FailsIf'Invalid name:'{⍺≢(⍴⍺)↑⍵}0⊃⎕DM
 :EndTrap

 r←T._OK
