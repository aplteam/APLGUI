 r←Test_Input_DataType_006(stopFlag batchFlag);n;⎕TRAP;defMat;res;DT;globalParms;parms;props;values
⍝ Exercise "Input" with data type "Spinner" with a "OnOkay" callback.
 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 DT←#.APLGUI.APLGUI.Enums.InputDataTypes

 #.⎕SHADOW'TEMP'
 'TEMP'#.⎕NS''
 #.TEMP.OnMyOK←{1 ''}

 props←0 2⍴'Numbers'('Step' 10)('Thumb' 3)
 defMat←⍉⍪'Numbers' ''(1+⍳20)DT.Spinner 6
 props⍪←'Numbers'(⊂('Thumb' 7))

 globalParms←∆GetGlobalParms
 parms←#.APLGUI.APLGUI.Input.CreateParms
 parms.props←props
 parms.posn←50 50
 parms.onOkay←'#.TEMP.OnMyOK'
 parms.addToCaption←'No. ',⍕∆GetTestCaseNo

 n←#.APLGUI.APLGUI.Input.Create defMat globalParms parms
 0 ∆Process n.∆Form

 n.Numbers ∆KeyPress⊂'RL'  ⍝ End
 ∆Process n.∆Form
 →GoToTidyUp 1≠n.Numbers.((Thumb-1)⊃Items)

 n.Numbers ∆KeyPress⊂'LL'  ⍝ Home
 0 ∆Process n.∆Form
 →GoToTidyUp 20≠n.Numbers.((Thumb-1)⊃Items)

 n.Numbers ∆KeyPress⊂'DC'  ⍝ ↓
 0 ∆Process n.∆Form
 →GoToTidyUp 19≠n.Numbers.((Thumb-1)⊃Items)

 n.Numbers ∆KeyPress⊂'DS'  ⍝ PgDwn
 0 ∆Process n.∆Form
 →GoToTidyUp 18≠n.Numbers.((Thumb-1)⊃Items)

 n.Numbers ∆KeyPress⊂'US'  ⍝ PgUp
 0 ∆Process n.∆Form
 →GoToTidyUp 19≠n.Numbers.((Thumb-1)⊃Items)
 n.Numbers ∆KeyPress⊂'UC'  ⍝ ↑
 0 ∆Process n.∆Form
 →GoToTidyUp 20≠n.Numbers.((Thumb-1)⊃Items)

 r←∆OK

∆TidyUp:
 n.∆CloseForm
