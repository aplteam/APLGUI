 r←Test_AskString_006(stopFlag batchFlag);parms;was;msg;n;⎕TRAP
⍝ Exercise the "OnOkay" callback with  a real check.
 r←T._Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 #.⎕SHADOW'TEMP'
 #.TEMP←⎕NS''
 #.TEMP.MyCallback←{
     n←⍵
     1≤' '+.=n.∆result:1
     n.StatusField1.Text←'Last & first name is requiered'
     n.StatusField1.BCol←n.∆globalParms.alarmColor
     0
 }
 #.TEMP.parms←#.APLGUI.APLGUI.Request.CreateParmsForString
 #.TEMP.parms.default←'Kai'
 #.TEMP.parms.timeout←0.1
 #.TEMP.parms.onOkay←'#.TEMP.MyCallback'

 n←#.TEMP.parms(#.APLGUI.APLGUI.Request.CreateParmsForString ∆Ask)'Your name:'
 ∆Process n.∆Form
 →T.GoToTidyUp 0≠' '+.=n.∆result
 ⎕NQ n.Input'GotFocus'
 n.Input ∆KeyPress⊂'RL'
 n.Input ∆KeyPress' Jaeger'
 ∆Process n.∆Form
 ⎕NQ n.Input 9995
 ⎕NQ n.Btn0'Select'
 ∆Process n.∆Form
 →T.GoToTidyUp n.∆result≢'Kai Jaeger'
 r←T._OK

∆TidyUp:
 n.∆CloseForm
