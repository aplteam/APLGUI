 r←Test_IE_001(stopFlag batchFlag);⎕TRAP;ref;n;html;rc
⍝ Test IE: show APLGui's readme.html file
 r←T._Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 #.⎕SHADOW'TEMP'
 'TEMP'#.⎕NS''
 ref←∆Create_IEcontainer #.TEMP
 n←#.APLGUI.APLGUI.IE.CreateIE ref
 #.APLGUI.APLGUI.IE.ShowHtmlFile n.IEobject(FilesAndDirs.PWD,'\readmefirst.html')
 ⎕DL 0.1
 :Trap 0
     html←#.APLGUI.APLGUI.IE.GetHTML n.IEobject
 :Else
     html←¯1
 :EndTrap
 →T.FailsIf' '≠1↑0⍴html
 →T.FailsIf 0=≢html
 r←T._OK

∆TidyUp:
 :Trap 0 ⋄ n.∆container.Close ⋄ :EndTrap
 :Trap 0 ⋄ rc←FilesAndDirs.DeleteFile n.∆container.IEobject.∆Filename ⋄ :EndTrap
 ⍝Done
