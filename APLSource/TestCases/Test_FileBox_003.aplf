 r←Test_FileBox_003(stopFlag batchFlag);myGuiParms;parms;⎕TRAP;path;n
⍝ Exercise the "Create" method with `parent`
 r←T._Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 myGuiParms←#.APLGUI.APLGUI.APLGuiGlobalParms.CreateDefaults
 myGuiParms.regKey←'MyApp\Kai1'
 myGuiParms.testMode←1
 myGuiParms.caption←0⊃⎕XSI
 myGuiParms.icon←⎕NEW'Icon'(⊂'File'(GetFile'Misc\Sample.ico'))

 parms←#.APLGUI.APLGUI.FileBox.CreateParms
 parms.addToCaption←'My request'
 parms.parent←⍎'F'⎕WC'Form'
 parms.style←#.APLGUI.APLGUI.Enums.SelectionStyles.multi

 n←myGuiParms parms #.APLGUI.APLGUI.FileBox.Create'C:\Windows\'

 r←T._OK
