 r←Test_Menubar_006(stopFlag batchFlag);parms;n;TheForm;⎕TRAP
⍝ Exercise the "Create" method with an invalid definition (using the name "Menubar")
 r←T._Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 parms←#.APLGUI.APLGUI.Menubar.CreateParms
 'TheForm'⎕WC'Form'('Coord' 'Pixel')('Posn'(35 45))('Size'(300 400))

 :Trap 0
     n←#.APLGUI.APLGUI.Menubar.Create TheForm MenuUsesNameMenubar parms(⎕NEW #.APLGUI.APLGUI.KeyCodes)
     →T.FailsIf 1
 :Else
     →T.FailsIf'The name "Menubar" is reserved and must not be used'≢0⊃⎕DM
 :EndTrap

 r←T._OK
