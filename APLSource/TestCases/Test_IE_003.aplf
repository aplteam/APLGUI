 r←Test_IE_003(stopFlag batchFlag);⎕TRAP;ref;n;html
⍝ Test IE: show APLGui's readme.html file
 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 #.⎕SHADOW'TEMP'
 'TEMP'#.⎕NS''
 ref←∆Create_IEcontainer #.TEMP
 n←#.APLGUI.APLGUI.IE.CreateIE ref
 #.APLGUI.APLGUI.IE.ShowHtmlFile n.IEobject(#.FilesAndDirs.EnforceSlash #.FilesAndDirs.PWD,'\readmefirst.html')
 ⎕DL 0.5
 :Trap 0
     html←#.APLGUI.APLGUI.IE.GetHTML n.IEobject
 :Else
     html←¯1
 :EndTrap
 →FailsIf' '≠1↑0⍴html
 →FailsIf 0∊⍴html
 r←∆OK

∆TidyUp:
 :Trap 0 ⋄ n.∆container.Close ⋄ :EndTrap
 :Trap 0 ⋄ ##.FilesAndDirs.DeleteFile n.∆container.IEobject.∆Filename ⋄ :EndTrap
⍝Done
