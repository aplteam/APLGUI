 r←Test_TableEdit_105(stopFlag batchFlag);parms;n;⎕TRAP;table;rowTitles
⍝ Test the "onRowChange" callback `
 r←T._Inactive
 :Return

 r←T._Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 . ⍝ Do we REALLY need this?! (Understand "makeCellEmpty"!)

 #.⎕SHADOW'TEMP'
 'TEMP'#.⎕NS''
 #.TEMP.counter←0

 #.TEMP.flag←0
 #.TEMP.OnRowChange←{
     .
     ⎕THIS.counter+←1
     2>⎕THIS.counter:0
     ⎕THIS.flag←1
     1
 }

 table←⍪'Obama' 'Bush' 'Clinton' 'Reagan' 'Kennedy'
 table,←'Barak' 'George' 'Bill' 'Ronald' 'John'
 table,←?5 20⍴1000000
 parms←#.APLGUI.APLGUI.Table.CreateParms
 parms.posn←35 25
 parms.size←400 600
 parms.caption←'Test_TableEdit_105: onRowChange callback'
 parms.confirmQuit←0
 parms.testMode←1
 parms.onRowChange←'#.TEMP.OnRowChange'

 n←#.APLGUI.APLGUI.Table.Create table #.APLGUI.APLGUI.APLGuiGlobalParms.CreateDefaults parms
 n.Grid ∆KeyPress'Ford'         ⍝ we need a change
 n.Grid ∆KeyPress⊂'ER'          ⍝ Make it permanent
 ∆Process n.∆Form
 1 ⎕NQ n.∆Form'Close'
 0.1 ∆Process n.∆Form
 →T.GoToTidyUp 0≠#.TEMP.flag
 →T.GoToTidyUp 1≠#.TEMP.counter
 1 ⎕NQ n.∆Form'Close'
 ∆Process n.∆Form

 →T.GoToTidyUp 1≠#.TEMP.flag
 →T.GoToTidyUp 2≠#.TEMP.counter
 →T.GoToTidyUp'Ford'≢↑0 0⌷n.∆result

 r←T._OK

∆TidyUp:
 n.∆CloseForm
