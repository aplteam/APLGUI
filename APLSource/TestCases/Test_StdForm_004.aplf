 r←Test_StdForm_004(stopFlag batchFlag);⎕TRAP;parms;n;globalParms;MyGuiParms
⍝ Bring up a form up with just one status field
 r←T._Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 CreateGlobalParms
 globalParms←⎕NS MyGuiParms
 globalParms.centerIn←⎕NEW'Form'(('Coord' 'Pixel')('Posn'(200 300))('Size'(400 600)))
 parms←#.APLGUI.APLGUI.StdForm.CreateParms
 :If ⍬ ⍬≡parms.size
     parms.size←200 400
 :EndIf
 parms.hasVersionField←0
 n←#.APLGUI.APLGUI.StdForm.Create globalParms parms
 ⎕DL 1
 ⎕NQ n.∆Form'Close'
 ⎕NQ globalParms.centerIn'Close'

 r←T._OK
