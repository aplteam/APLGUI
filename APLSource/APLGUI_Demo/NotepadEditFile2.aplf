 NotepadEditFile2;txt;parms;n;res;globalParms;changeFlag
⍝ Simple NotePad with default parameters
 globalParms←##.APLGUI.APLGuiGlobalParms.CreateDefaults
 globalParms.icon←#.⎕NEW'Icon'(⊂'File'(GetFile'Sample.ico'))
 globalParms.regKey←∆GetRegPath,'Notepad_Test\'

 parms←##.APLGUI.Notepad.CreateParmsForFile
 parms.addToCaption←'Copyright notice'
 parms.posn←35 25
 #.⎕SHADOW¨'OnStart' 'OnClose' 'OnLoad'
 #.OnStart←{
     n←⍵
     msg←'NOTE: the text MUST NOT contain the word "fuck"!'
     parms←##.APLGUI.Dialogs.CreateParmsForShowMsg
     parms.addToCaption←'Copyright notice'
     _←n.∆globalParms parms n.##.APLGUI.Dialogs.ShowMsg msg
     ⍬
 }
 #.OnClose←{
     n←⍵
     txt←#.APLTreeUtils.Lowercase n.Edit.Text
     txt←' ',⊃,/txt,¨' '
     0=+/' fuck '⍷txt:0
     _←##.APLGUI.Dialogs.ShowMsg'Sorry, but you disobeyed the rules!'
     1
 }
 parms.onStart←'#.OnStart'
 parms.onClose←'#.OnClose'
 parms.hasMenuItem_Open←1

 changeFlag←globalParms parms ##.APLGUI.Notepad.EditFile''
 ⎕←'The text ',(changeFlag⊃'didn''t get' 'got'),' changed'
⍝Done
