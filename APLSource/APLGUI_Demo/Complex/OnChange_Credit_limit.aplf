 r←OnChange_Credit_limit n;msg;parms;value
 value←↑↑(//)⎕VFI n.Credit_limit.Text
 :If 9999<value
     msg←'The maximum credit limit is 9999!'
     r←0 msg
 :ElseIf 999<value
     parms←##.APLGUI.Dialogs.CreateParmsForYesOrNo
     parms.addToCaption←'Credit limit warning'
     parms.centerIn←n.∆Form
     msg←⊂'Are you sure?'
     msg,←⊂''
     msg,←⊂'Normally the credit limit should not exceed 999.'
     :If n.∆globalParms parms ##.APLGUI.Dialogs.YesOrNo msg
         r←1
     :Else
         n.Credit_limit.Value←999
         r←0
     :EndIf
 :Else
     r←1
 :EndIf
