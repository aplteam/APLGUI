 {r}←n OnNavigate msg;i;URL;url;self;allowed
 self←msg[⎕IO]
 url←#.APLTreeUtils.Lowercase URL←3⊃msg
 :If r←'about:blank'≢url
     allowed←'http://google' 'https://google' 'http://www.google' 'https://www.google'
     r←∨/allowed{⍺≡(⍴⍺)↑⍵}¨⊂url
 :EndIf
 :If 0=r
     self.Stop
     ⎕←'Go to ',url
     ⎕←'Suppressed by user-defined callback.'
 :EndIf
