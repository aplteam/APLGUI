 r←Test_Input_Callbacks_007(stopFlag batchFlag);n;⎕TRAP;defMat;res;DT;globalParms;parms;printerList
⍝ Exercise "Input" with on "onInitialMsg" callback. See also Test_Input_Callbacks_004.
 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 DT←#._APLGUI.GUI.Enums.InputDataTypes
 #.⎕SHADOW'TEMP'
 'TEMP'#.⎕NS''
 #.TEMP.flag←0
 #.TEMP.OnInitialMsg←{
     ⎕THIS.flag←1
     ⍬
 }

 defMat←0 5⍴''
 defMat⍪←'Label' 'Select your printer:' ''DT.Label 0
 printerList←'LaserJet' 'InkJet' 'PDF'
 defMat⍪←'Text' ''printerList DT.DropDown 0
 defMat⍪←'Save_copy' '' 1 DT.YesNo 0

 globalParms←∆GetGlobalParms
 parms←#._APLGUI.GUI.Input.CreateParms
 parms.posn←50 50
 parms.onInitialMsg←#.TEMP'OnInitialMsg'
 parms.addToCaption←'No. ',⍕∆GetTestCaseNo

 n←#._APLGUI.GUI.Input.Create defMat globalParms parms
 0 ∆Process n.∆Form
 →GoToTidyUp #.TEMP.flag=0

 r←∆OK

∆TidyUp:
 n.∆CloseForm
