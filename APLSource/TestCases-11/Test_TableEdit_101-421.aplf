 r←Test_TableEdit_101(stopFlag batchFlag);parms;n;⎕TRAP;table;rowTitles
⍝ Test the "onCellChange" callback
 r←∆Inactive
 :Return

 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 #.⎕SHADOW'TEMP'
 'TEMP'#.⎕NS''
 #.TEMP.counter←0

 #.TEMP.flag←0
 #.TEMP.OnCellChange←{
     ⎕THIS.counter+←1
     2>⎕THIS.counter:0
     ⎕THIS.flag←1
     1
 }

 table←⍪'Obama' 'Bush' 'Clinton' 'Reagan' 'Kennedy'
 table,←'Barak' 'George' 'Bill' 'Ronald' 'John'
 table,←?5 20⍴1000000
 parms←#._APLGUI.GUI.Table.CreateParms
 parms.posn←35 25
 parms.size←400 600
 parms.caption←'Test_TableEdit_101: onCellChange callback'
 parms.confirmQuit←0
 parms.testMode←1
 parms.onCellChange←'#.TEMP.OnCellChange'

 n←#._APLGUI.GUI.Table.Create table #._APLGUI.GUI.APLGuiGlobalParms.CreateDefaults parms
 n.Grid ∆KeyPress'AA'
 n.Grid ∆KeyPress⊂'ER'
 0.5 ∆Process n.∆Form
 n.Grid ∆KeyPress'Ford'
 n.Grid ∆KeyPress⊂'ER'
 0.5 ∆Process n.∆Form

 →GoToTidyUp 1≠#.TEMP.flag
 →GoToTidyUp 2≠#.TEMP.counter
 →GoToTidyUp'Ford'≢↑0 0⌷n.Grid.Values

 r←∆OK

∆TidyUp:
 n.∆CloseForm
