 r←Test_CreateButtonForm_005(stopFlag batchFlag);myGuiParms;parms;n;⎕TRAP
⍝ Exercise "Dialog.Create": width test; the "autoPress" message defines the width of the text
 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 myGuiParms←#._APLGUI.GUI.APLGuiGlobalParms.CreateDefaults
 myGuiParms.regKey←'MyApp\Kai1'
 myGuiParms.icon←⎕NEW'Icon'(⊂'File'(GetFile'Sample.ico'))
 parms←#._APLGUI.GUI.Dialogs.CreateParmsForYesOrNo

 parms.addToCaption←'Hi there'
 parms.question←'Sure?'
 parms.buttons←'Yes' 'No'
 parms.autoPress←1
 parms.timeout←0.1
 parms.minSize←⍬ ⍬
 parms←#._APLGUI.GUI.APLGuiUtils.CheckParmsForProgressbarAndStatusbar parms
 n←#._APLGUI.GUI.Dialogs.CreateButtonForm myGuiParms parms
 ⎕DL 0.1
 n←#._APLGUI.GUI.Dialogs.AdjustSize n
 :If ⍬ ⍬≡parms.posn
     {}n.∆Form #._APLGUI.GUI.APLGuiHelpers.CenterIn myGuiParms.centerIn{(0∊⍴⍵):⍺ ⋄ ⍵}parms.centerIn
 :EndIf
 n←#._APLGUI.GUI.Dialogs.HandleFocus n
 n(#._APLGUI.GUI.Dialogs.CreateAutoPressTimer)←parms.timeout
 n.∆Form.Wait
 →(0≡PassesIf{(120<⍵)∧(300>⍵)}n.∆Form.Size[1])/∆TidyUp

∆TidyUp:
 n.∆CloseForm

 r←∆OK
