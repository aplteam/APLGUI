 r←Test_CreateButtonForm_002(stopFlag batchFlag);myGuiParms;parms;n;⎕TRAP
⍝ Exercise "Dialog.Create": width test; the two buttons define the width
 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 myGuiParms←#._APLGUI.GUI.APLGuiGlobalParms.CreateDefaults
 myGuiParms.regKey←'MyApp\Kai1'
 myGuiParms.icon←⎕NEW'Icon'(⊂'File'(GetFile'Sample.ico'))
 parms←#._APLGUI.GUI.Dialogs.CreateParmsForYesOrNo
 parms.addToCaption←'Hi there'
 parms.question←'Sure?'
 parms.buttons←'Absolutely Yes' 'No, thank you'
 n←#._APLGUI.GUI.Dialogs.CreateButtonForm myGuiParms parms
 ⎕DL 0.2
 n←#._APLGUI.GUI.Dialogs.AdjustSize n
 :If ⍬ ⍬≡parms.posn
     {}n.∆Form #._APLGUI.GUI.APLGuiHelpers.CenterIn myGuiParms.centerIn{(0∊⍴⍵):⍺ ⋄ ⍵}parms.centerIn
 :EndIf
 →(0≡PassesIf{(400<⍵)∧(600>⍵)}n.∆Form.Size[1])/∆TidyUp

∆TidyUp:
 n.∆CloseForm

 r←∆OK
