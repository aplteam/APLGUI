 r←Test_StdForm_013(stopFlag batchFlag);⎕TRAP;globalParms;parms;n
⍝ Test "Icon"
 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 parms←#._APLGUI.GUI.StdForm.CreateParms
 parms.icon←⎕NEW'Icon'(⊂'File'(GetFile'Sample.ico'))
 parms.size←200 400
 parms.posn←60 60
 parms.minSize←100 200
 n←#._APLGUI.GUI.StdForm.Create parms
 0.2 ∆Process n.∆Form
 →PassesIf n.∆Form.IconObj.Type≡'Icon'
 n.∆CloseForm

 r←∆OK
