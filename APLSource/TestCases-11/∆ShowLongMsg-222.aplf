 n←{x}∆ShowLongMsg msg;globalParms;parms;n;⎕TRAP
 :Access Public Shared
 ⎕TRAP←(#._APLGUI.GUI.APLGuiUtils.APLGuiError'C' '(⎕IO⊃⎕DM) ⎕SIGNAL ⎕en')(0 'N')
 x←{(0<⎕NC ⍵):⍎⍵ ⋄ ⍬}'x'
 (globalParms parms)←#._APLGUI.GUI.Dialogs.CreateParmsForShowLongMsg #._APLGUI.GUI.APLGuiUtils.GetParms x
 parms←#._APLGUI.GUI.APLGuiUtils.CheckTimeout globalParms parms
 :If ¯1=parms.autoPress
     parms.focusButton←0
 :Else
     parms.focusButton←parms.autoPress
 :EndIf
 :If ~0∊⍴msg
     parms.question←msg
 :EndIf
 :If ¯1=parms.focusButton
     parms.focusButton←0
 :ElseIf ¯1≠parms.autoPress
     parms.focusButton←parms.autoPress
 :EndIf
 n←#._APLGUI.GUI.Dialogs.CreateLongMsgForm globalParms parms
 n←#._APLGUI.GUI.Dialogs.AdjustSize n
⍝Done
