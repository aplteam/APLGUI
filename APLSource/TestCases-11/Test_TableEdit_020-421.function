 r←Test_TableEdit_020(stopFlag batchFlag);parms;n;⎕TRAP;table;rowTitles
⍝ Ctrl+C and Ctrl+V on a single cell in "Scroll" mode.
 r←∆Inactive
 :Return

 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 table←⍉⊃('Obama' 'Bush' 'Clinton' 'Reagan' 'Kennedy' 'Carter')(1 0 1 0 1 1)
 table←table,table
 parms←#._APLGUI.GUI.Table.CreateParms
 parms.posn←35 25
 parms.size←400 600
 parms.colTitles←'Name' 'Democrat'
 parms.addToCaption←'Testing Table.Run'
 parms.confirmQuit←0
 parms.testMode←1
 parms.dataTypes←#._APLGUI.GUI.Enums.TableDataTypes.(Character Numeric Character YesNo)

 n←#._APLGUI.GUI.Table.Create table #._APLGUI.GUI.APLGuiGlobalParms.CreateDefaults parms

 n.Grid.CurCell←1 0
 n.Grid.SelItems←(1 0)(1 0)
 n.Grid ∆KeyPress⊂'CP'    ⍝TODO⍝  This causes a GridCopyError - why?!
 ∆Process n.∆Form
 n.Grid.CurCell←2 0
 n.Grid.SelItems←(2 0)(2 0)
 n.Grid ∆KeyPress⊂'PT'
 ∆Process n.∆Form
 table[2;0]←⊂'Bush'
 →GoToTidyUp n.Grid.Values≢table

 r←∆OK

∆TidyUp:
 n.∆CloseForm
