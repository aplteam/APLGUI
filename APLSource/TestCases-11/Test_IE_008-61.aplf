 r←Test_IE_008(stopFlag batchFlag);⎕TRAP;ref;n;html
⍝ Test IE: view some dynamically (= in the WS) created HTML/
 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 #.⎕SHADOW'TEMP'
 'TEMP'#.⎕NS''
 ref←∆Create_IEcontainer #.TEMP
 n←#._APLGUI.GUI.IE.CreateIE ref
 html←('<h1>Test case ',(¯3↑↑⎕XSI),'</h1>')'<p>Some dynamically created HTML</p>'
 #._APLGUI.GUI.IE.ShowHtml n.IEobject html
 ⎕DL 0.05
 :Trap 0
     html←#._APLGUI.GUI.IE.GetHTML n.IEobject
 :Else
     html←¯1
 :EndTrap
 →FailsIf' '≠1↑0⍴html
 →FailsIf 0∊⍴html
 r←∆OK

∆TidyUp:
 :Trap 0 ⋄ n.∆container.Close ⋄ :EndTrap
