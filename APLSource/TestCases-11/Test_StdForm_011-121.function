 r←Test_StdForm_011(stopFlag batchFlag);⎕TRAP;parms;n;rf1;rf2;globalParms;MyGuiParms
⍝ Bring up a form and add 3 tabs and two buttons to it
 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 CreateGlobalParms
 globalParms←⎕NS MyGuiParms
 parms←#._APLGUI.GUI.StdForm.CreateParms
 parms.addToCaption←'Tabs & 2 Buttons'
 :If ⍬ ⍬≡parms.size
     parms.size←400 500
 :EndIf
 n←#._APLGUI.GUI.StdForm.Create globalParms parms
 n←#._APLGUI.GUI.StdForm.AddTabs n('First' 'Second' 'Third')
 n←#._APLGUI.GUI.StdForm.AddButtons n('OK' 'Cancel')

 n.Edit_00←n.Tab_00_SF.⎕NEW'Edit'(('Text' 'First')('Posn'(15 15)))
 n.Edit_01←n.Tab_01_SF.⎕NEW'Edit'(('Text' 'Second')('Posn'(45 15)))
 n.Edit_02←n.Tab_02_SF.⎕NEW'Edit'(('Text' 'Third')('Posn'(75 15)))

 ⎕DL 1
 ⎕NQ n.∆Form'Close'

 r←∆OK
