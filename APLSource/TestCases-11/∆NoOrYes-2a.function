 n←{x}∆NoOrYes question;n;_;parms;globalParms
    ⍝ Modal dialog asking a yes-no question with "No" being the default button
 x←{(0<⎕NC ⍵):⍎⍵ ⋄ ⍬}'x'
 (globalParms parms)←#._APLGUI.GUI.Dialogs.CreateParmsForNoOrYes #._APLGUI.GUI.APLGuiUtils.GetParms x
 parms←#._APLGUI.GUI.APLGuiUtils.CheckTimeout globalParms parms
 :If 0∊⍴parms.autoPress
     parms.focusButton←1
 :Else
     parms.focusButton←parms.autoPress
 :EndIf
 :If ~0∊⍴question
     parms.question←question
 :EndIf
 parms.buttons←'Yes' 'No'
 n←#._APLGUI.GUI.Dialogs.CreateButtonForm globalParms parms
 n←#._APLGUI.GUI.Dialogs.HandleFocus n
 n(#._APLGUI.GUI.Dialogs.CreateAutoPressTimer)←parms.timeout
