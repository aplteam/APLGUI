 r←Test_Input_DataType_004(stopFlag batchFlag);n;⎕TRAP;DT;defMat;month;globalParms;parms;props
⍝ Exercise "Input" with data type "DropDown".
 r←∆Failed
 ⎕TRAP←(999 'C' '. ⍝ Deliberate error')(0 'N')

 DT←#._APLGUI.GUI.Enums.InputDataTypes

 defMat←0 7⍴''
 month←'January' 'February' 'March' 'April' 'Mai' 'June' 'July' 'August' 'September' 'October' 'November' 'December'
 defMat⍪←'DD' ''month DT.DropDown 0 1 1
 props←1 2⍴'DD'(⊂'SelItems'(12↑0 0 0 1))

 globalParms←∆GetGlobalParms
 parms←#._APLGUI.GUI.Input.CreateParms
 parms.posn←50 50
 parms.addToCaption←'No. ',⍕∆GetTestCaseNo
 parms.props←props
 parms.size←500 400

 n←#._APLGUI.GUI.Input.Create defMat globalParms parms
 ∆Process n.∆Form

 →GoToTidyUp n.DD.SelItems≢12↑¯4↑1
 n.DD ∆KeyPress⊂'DS'
 n.DD ∆KeyPress⊂'US'

 n.DD ∆KeyPress⊂'LL'
 n.DD ∆KeyPress⊂'RL'

 n.DD ∆KeyPress⊂'UC'
 n.DD ∆KeyPress⊂'DC'

 r←∆OK

