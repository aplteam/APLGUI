 {ns}←InjectNumberedHeaders ns;html;no;header;level;searchFor;ind;length;levelsToBeNumbered;i;pos;at;lengths;news;pieces;k;n
⍝ Headers come in document order, so each one is searched for only after the previous one (that also
⍝ takes care of duplicate captions), and the HTML is put together once at the end.
⍝ The search looks at a window after the previous header first, so the HTML is not copied for every header.
 :If 0≠≢ns.headers  ⍝ Are their any headers at all?
     levelsToBeNumbered←{1≠≢⍵:⍵ ⋄ ⍳⍵}ns.parms.numberHeaders
 :AndIf ∨/levelsToBeNumbered∊ns.headers[;1] ⍝ Right levels?!
     html←FlattenHTML ns.html
     pos←0                                                  ⍝ Search from here on
     at←lengths←news←⍬
     :For i :In ⍳≢ns.headers
         (level header no)←ns.headers[i;1 3 4]
         :If level∊levelsToBeNumbered
             searchFor←A.DMB'>',header,'</h',(⍕level),'>'
             n←20000⌊(≢html)-pos                            ⍝ A window after the previous header first ...
             ind←1⍳⍨searchFor⍷html[pos+⍳n]
             :If ind>n                                      ⍝ ... the whole rest only if not found there
                 ind←1⍳⍨searchFor⍷pos↓html
             :EndIf
             ind+←pos                                       ⍝ Position of the ">" that precedes the caption
             :If ind≤≢html
                 length←(≢searchFor)-1+≢'</h',(⍕level),'>'  ⍝ Length of the caption as found in the HTML
                 at,←ind
                 lengths,←length
                 news,←⊂no,((0<≢no)/' '),header
                 pos←ind+length
             :EndIf
         :EndIf
     :EndFor
     pieces←''
     pos←0
     :For k :In ⍳≢at
         pieces,←html[pos+⍳at[k]-pos](k⊃news)               ⍝ Everything up to and including the ">", then the new caption
         pos←at[k]+lengths[k]
     :EndFor
     ns.html←(⎕UCS 13)A.Split(⊃,/pieces),pos↓html
 :EndIf
